#!/usr/bin/env bash
set -euo pipefail
# Use the active release, including after a code rollback.
WUWEI_ROOT="${WUWEI_ROOT:-/opt/wuwei/current}"
if [ -z "${WUWEI_VENV:-}" ]; then
  WUWEI_VENV="$WUWEI_ROOT/.venv"
  # Transitional rollback to an older release still uses its original shared
  # environment. New releases always ship their own .venv and never mutate it.
  if [ ! -x "$WUWEI_VENV/bin/python" ] && [ ! -f "$WUWEI_ROOT/backend/requirements.lock" ]; then
    WUWEI_VENV="/opt/wuwei/venv"
  fi
fi
export PYTHONPATH="$WUWEI_ROOT/backend${PYTHONPATH:+:$PYTHONPATH}"
exec "$WUWEI_VENV/bin/python" -m app.admin "$@"
